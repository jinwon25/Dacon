{
  "protocol": "V108_PITCHER_BALANCED_WEIGHTING_V1",
  "frozen_before_run": "2026-08-22",
  "hypothesis": "Partial inverse-sqrt pitcher-season weighting reduces domination by high-volume pitchers while preserving row-level evaluation relevance and creates a portable error axis.",
  "audit_years": [2020, 2021, 2022, 2023, 2024],
  "selection_years": [2020, 2021],
  "locked_years": [2022, 2023, 2024],
  "routes": {
    "R_CORE": ["R_CORE"],
    "R_CORE_F": ["R_CORE", "F"],
    "ALL": ["R_CORE", "R_ANCHOR", "F"]
  },
  "eta_cap": 0.25,
  "pitcher_count_exponent": 0.5,
  "normalize_within_season": true,
  "recency_half_life": 2.0,
  "model": {
    "objective": "binary",
