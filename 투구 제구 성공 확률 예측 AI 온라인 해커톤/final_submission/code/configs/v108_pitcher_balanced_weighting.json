    "learning_rate": 0.025,
    "num_leaves": 31,
    "max_depth": 5,
    "min_child_samples": 900,
    "subsample": 0.85,
    "subsample_freq": 1,
    "colsample_bytree": 0.82,
    "reg_alpha": 3.0,
    "reg_lambda": 25.0,
