{
  "protocol": "V107_BATTER_ASOF_ABLATION_V1",
  "frozen_before_run": "2026-08-22",
  "hypothesis": "Removing batter cumulative command-outcome summaries while retaining handedness and game context reduces nonportable noise in a pitcher-command target.",
  "audit_years": [2020, 2021, 2022, 2023, 2024],
  "selection_years": [2020, 2021],
  "locked_years": [2022, 2023, 2024],
  "routes": {
    "R_CORE": ["R_CORE"],
    "R_CORE_F": ["R_CORE", "F"],
    "ALL": ["R_CORE", "R_ANCHOR", "F"]
  },
  "eta_cap": 0.25,
  "dropped_columns": [
    "asof_batter_n",
    "asof_batter_success_rate",
    "asof_batter_middle_rate",
    "shrunk_batter_rate"
  ],
  "recency_half_life": 2.0,
  "model": {
    "objective": "binary",
    "n_estimators": 520,
    "learning_rate": 0.025,
    "num_leaves": 31,
    "max_depth": 5,
    "min_child_samples": 900,
    "subsample": 0.85,
    "subsample_freq": 1,
    "colsample_bytree": 0.82,
    "reg_alpha": 3.0,
    "reg_lambda": 25.0,
    "max_bin": 127,
    "random_state": 9701,
    "n_jobs": 6,
    "verbosity": -1
  },
  "prohibited": [
    "dropping batter handedness or game context",
    "game_month as a model feature",
    "same-season or future target aggregates",
    "audit labels in model fitting or recipe selection",
    "test aggregates, order, frequency or distribution",
    "Public-score-derived route or weight"
  ]
}
